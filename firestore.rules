rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Kendi profil bilgilerini güncelleyebilme
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Uygulama verilerine sadece yetkili (Admin) e-postalar yazabilir
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                   (request.auth.token.email == 'admin@otomatpro.com' || 
                    request.auth.token.email == 'cihaterol@gmail.com');
    }
  }
}
